#!/bin/bash
# Pre-commit hook for LemGendaryModels
# Enforces Python compilation, markdownlint, model checkpoint integrity, and zero volatile residue.

echo "Running LemGendaryModels pre-commit verification..."

if ! python verify_models.py --staged; then
    echo "====================================================="
    echo "COMMIT BLOCKED: Verification failed."
    echo "====================================================="
    exit 1
fi

echo "[SUCCESS] All checks passed! Proceeding with commit."
exit 0
